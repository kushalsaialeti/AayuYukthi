# Copy to .env (root) / server/.env / apps/*/ .env as needed. Never commit real secrets.
# See docs/ENVIRONMENT.md

# ---- Server ----
NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://aayuyukthi:aayuyukthi@localhost:5432/aayuyukthi_dev
# Supabase: pooler URL above (port 6543); direct host for migrations below
# DIRECT_DATABASE_URL=postgres://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres
JWT_SECRET=change-me-in-every-environment-min-32-chars
CORS_ORIGIN=http://localhost:5173,http://localhost:5174
LOG_LEVEL=info
PG_POOL_MAX=10

# Keep-Alive (Render & Supabase Sleep Prevention)
# Render automatically injects RENDER_EXTERNAL_URL in production (e.g. https://aayuyukthi-api.onrender.com)
RENDER_EXTERNAL_URL=
KEEP_ALIVE_INTERVAL_MINUTES=8
KEEP_ALIVE_DISABLED=false

# Media (Cloudinary) — leave empty for reference-only dev mode
# MEDIA_PROVIDER=cloudinary
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# MEDIA_MAX_BYTES=10485760

# Future providers (leave empty until configured)
# TRANSLATION_API_KEY=
# SMTP_HOST=
# SMS_PROVIDER_KEY=
# OBJECT_STORAGE_ENDPOINT=
# OBJECT_STORAGE_BUCKET=

# ---- Web (public + customer) ----
# VITE_API_BASE_URL=http://localhost:4000/api/v1
# VITE_DEFAULT_LOCALE=en
