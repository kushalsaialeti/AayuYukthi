# =============================================================================
# Render Deployment — Environment Variables for @aayuyukthi/server
# =============================================================================

NODE_ENV=production
PORT=10000

# Supabase PostgreSQL Database Connection Strings
# 1. DATABASE_URL: Pooler connection string (Port 6543) for high-performance application queries
#    Example: postgres://postgres.PROJECT_REF:PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL=postgres://postgres:PASSWORD@db.PROJECT.supabase.co:6543/postgres

# 2. DIRECT_DATABASE_URL: Direct database connection (Port 5432) for running schema migrations
#    Example: postgres://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres
DIRECT_DATABASE_URL=postgres://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres

# Security Secrets (Must be at least 32 characters in production)
JWT_SECRET=production-secret-min-32-characters-random-string

# Allowed CORS Origins (Vercel frontend domain)
# Example: https://aayuyukthi.vercel.app,http://localhost:5173
CORS_ORIGIN=https://aayuyukthi.vercel.app

# Server Logging & Pooling
LOG_LEVEL=info
PG_POOL_MAX=10

# Keep-Alive Configuration (Render & Supabase Sleep Prevention)
# Render automatically sets RENDER_EXTERNAL_URL in production (e.g. https://aayuyukthi-api.onrender.com)
RENDER_EXTERNAL_URL=https://aayuyukthi-api.onrender.com
KEEP_ALIVE_INTERVAL_MINUTES=8
KEEP_ALIVE_DISABLED=false

# Optional Integrations
RESEND_API_KEY=
RESEND_FROM_EMAIL=AayuYukthi Care <onboarding@resend.dev>
