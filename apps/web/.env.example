# =============================================================================
# Vercel Deployment — Environment Variables for @aayuyukthi/web
# =============================================================================

# Live Render backend URL (include /api/v1 prefix)
# Example: https://aayuyukthi-api.onrender.com/api/v1
VITE_API_BASE_URL=https://aayuyukthi-api.onrender.com/api/v1

# Default UI locale ('en' or 'te')
VITE_DEFAULT_LOCALE=en
